# Backend API Gateway Settings
BACKEND_PORT=5000
LOG_LEVEL=INFO

# Agent Core Service URL (Port 8000)
AGENT_SERVICE_URL=http://127.0.0.1:8000

# Supabase Credentials (optional - falls back to in-memory/sqlite if blank)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_or_service_role_key
