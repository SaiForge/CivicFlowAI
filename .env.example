# ── LLM Provider ─────────────────────────────────────────────
# "openrouter" | "gemini" | "openai" | "auto"
LLM_PROVIDER=openrouter

# ── OpenRouter ────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── OpenAI (if LLM_PROVIDER=openai) ──────────────────────────
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
VISION_MODEL_NAME=gpt-4o-mini

# ── Google Gemini (if LLM_PROVIDER=gemini) ───────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# ── PostgreSQL (Docker local / Supabase cloud) ────────────────
POSTGRES_USER=civicflow
POSTGRES_PASSWORD=civicflow_secret
POSTGRES_DB=civicflow
# When using Supabase, override DATABASE_URL directly:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Backend JWT Auth ──────────────────────────────────────────
SECRET_KEY=change_me_in_production_civicflow_2024
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Agent System ──────────────────────────────────────────────
AGENT_DELAY_SECONDS=5.0
MAX_RETRIES=2
CONFIDENCE_THRESHOLD=0.7

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
